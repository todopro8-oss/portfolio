---
import type { GetStaticPaths } from 'astro';
import ProyectoPlantilla from '../../../../components/ProyectoPlantilla.astro';
import { proyectosDelBar, vecinos } from '../../../../lib/proyectos';

export const getStaticPaths = (async () => {
  const lista = await proyectosDelBar();
  return lista.map((proyecto) => ({ params: { slug: proyecto.data.slug }, props: { proyecto, ...vecinos(lista, proyecto.data.slug) } }));
}) satisfies GetStaticPaths;

const { proyecto, anterior, siguiente } = Astro.props;
---

<ProyectoPlantilla idioma="en" proyecto={proyecto} anterior={anterior} siguiente={siguiente} />
