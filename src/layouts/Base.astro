---
// Esqueleto de todas las páginas: idioma, título, descripción, canónica, hreflang y navegación
// sin recarga (<ClientRouter />). La tipografía se sirve desde el propio sitio.
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { IDIOMAS, ruta, textos, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
  /** Camino sin base ni idioma («/carta/»): sirve para la canónica y las versiones en otro idioma. */
  camino: string;
  titulo?: string;
  descripcion?: string;
  sinIndexar?: boolean;
}

const { idioma, camino, titulo, descripcion, sinIndexar = false } = Astro.props;
const t = textos(idioma);
const tituloCompleto = titulo ? `${titulo} · ${t.sitio}` : `${t.sitio} — Diego Pérez Muñoz`;
const url = (i: Idioma) => new URL(ruta(camino, i), Astro.site).href;
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion ?? t.descripcionSitio} />
    <link rel="canonical" href={url(idioma)} />
    {IDIOMAS.map((i) => <link rel="alternate" hreflang={i} href={url(i)} />)}
    <link rel="alternate" hreflang="x-default" href={url('es')} />
    {sinIndexar && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#1f2e27" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`} />
    <ClientRouter />
  </head>
  <body>
    <a class="saltar" href="#contenido">{t.nav.saltar}</a>
    <slot />
    <script>
      import { CLAVE_IDIOMA } from '../i18n';

      // El idioma elegido se recuerda (spec, sección 13). Delegado en document: sobrevive a la
      // navegación sin recarga.
      document.addEventListener('click', (e) => {
        const enlace = (e.target as Element | null)?.closest<HTMLElement>('[data-idioma]');
        if (!enlace?.dataset.idioma) return;
        try {
          localStorage.setItem(CLAVE_IDIOMA, enlace.dataset.idioma);
        } catch {
          // Sin almacenamiento (modo privado estricto): no pasa nada.
        }
      });
    </script>
  </body>
</html>
