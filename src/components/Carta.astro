---
// La carta: la vía rápida y el fallback de todo (spec, sección 13). Estética de carta de bar impresa;
// los precios se sustituyen por el año y el tipo.
import { Picture } from 'astro:assets';
import { local, ruta, textos, type Idioma } from '../i18n';
import type { Proyecto } from '../lib/proyectos';
import ContactoCard from './ContactoCard.astro';

interface Props {
  idioma: Idioma;
  proyectos: Proyecto[];
  /** Texto del <h1>: en la portada es el nombre completo del sitio. */
  h1: string;
  /** El h1 existe para lectores y buscadores, pero en pantalla manda el título de la carta. */
  h1Oculto?: boolean;
}

const { idioma, proyectos, h1, h1Oculto = false } = Astro.props;
const t = textos(idioma);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="carta" aria-labelledby="titulo-carta">
  <div class="carta__hoja">
    <p class="rotulo carta__casa">Diego Pérez Bar</p>
    {
      h1Oculto ? (
        <>
          <h1 class="solo-lector">{h1}</h1>
          <p class="carta__titulo" id="titulo-carta" aria-hidden="true">
            {t.carta.titulo}
          </p>
        </>
      ) : (
        <h1 class="carta__titulo" id="titulo-carta">
          {h1}
        </h1>
      )
    }
    <p class="carta__lema">{t.carta.lema}</p>

    <h2 class="carta__seccion">{t.carta.proyectos}</h2>
    <ol class="carta__lista">
      {
        proyectos.map((p) => (
          <li>
            <a class="plato" href={ruta(`/proyectos/${p.data.slug}/`, idioma)}>
              <span class="plato__foto">
                {p.data.portada ? (
                  <Picture src={p.data.portada} formats={['avif', 'webp']} widths={[128, 256]} sizes="128px" alt="" />
                ) : (
                  <span class="plato__vacio" aria-hidden="true">
                    ?
                  </span>
                )}
              </span>
              <span class="plato__texto">
                <span class="plato__nombre">{local(p.data.titulo, idioma)}</span>
                <span class="plato__tipo">{local(p.data.tipo, idioma)}</span>
              </span>
              <span class="plato__relleno" aria-hidden="true" />
              <span class="plato__precio">{p.data.borrador ? t.carta.proximamente : p.data.anio}</span>
            </a>
          </li>
        ))
      }
    </ol>

    <h2 class="carta__seccion">{t.carta.deLaBarra}</h2>
    <ul class="carta__extras">
      <li><a href={ruta('/cv/', idioma)}>{t.carta.cv}</a></li>
      <li><a href={`${base}cv.pdf`} download>{t.carta.cvPdf}</a></li>
      <li><a href={ruta('/mus/', idioma)}>{t.carta.mus}</a></li>
    </ul>

    <h2 class="carta__seccion">{t.carta.contacto}</h2>
    <ContactoCard idioma={idioma} />
  </div>
</section>

<style>
  .carta {
    padding: clamp(1rem, 4vw, 3rem) var(--margen) clamp(2rem, 6vw, 4rem);
  }
  .carta__hoja {
    max-width: 44rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    background: var(--papel);
    border: 1px solid var(--papel-borde);
    outline: 1px solid var(--papel-borde);
    outline-offset: -10px;
    box-shadow: 0 1px 0 var(--papel-borde), 0 18px 40px -24px rgb(58 36 21 / 0.45);
  }
  .carta__casa {
    text-align: center;
    margin: 0;
  }
  .carta__titulo {
    margin: 0.2rem 0 0;
    text-align: center;
    font-size: clamp(2.6rem, 9vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .carta__lema {
    text-align: center;
    font-style: italic;
    color: var(--tinta-suave);
    margin: 0.6rem 0 0;
  }
  .carta__seccion {
    margin: 2.2rem 0 0.8rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid var(--tinta);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .carta__lista,
  .carta__extras {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .plato {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.6rem 0;
    text-decoration: none;
    min-height: 44px;
  }
  .plato:hover .plato__nombre {
    text-decoration: underline;
  }
  .plato__foto {
    flex: none;
    width: 64px;
    height: 64px;
    overflow: hidden;
    border: 1px solid var(--tinta);
    background: var(--linea);
  }
  .plato__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .plato__vacio {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-weight: 800;
    font-size: 1.5rem;
    background: var(--tinta);
    color: var(--papel);
  }
  .plato__texto {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .plato__nombre {
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0.01em;
  }
  .plato__tipo {
    font-size: 0.88rem;
    color: var(--tinta-suave);
  }
  .plato__relleno {
    flex: 1;
    min-width: 1.5rem;
    align-self: flex-end;
    margin-bottom: 0.8rem;
    border-bottom: 2px dotted var(--tinta-suave);
  }
  .plato__precio {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* En el móvil no cabe la línea de puntos: el año se va a la derecha y el tipo respira. */
  @media (max-width: 30rem) {
    .carta__hoja {
      padding: 1.25rem 1rem;
    }
    .plato {
      gap: 0.75rem;
    }
    .plato__foto {
      width: 56px;
      height: 56px;
    }
    .plato__relleno {
      display: none;
    }
    .plato__precio {
      margin-left: auto;
      font-size: 0.9rem;
    }
  }
  .carta__extras li a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }
</style>
