---
// Subpágina de un look de R3UP (/proyectos/r3up/look/<n>/), como en el portfolio clásico.
import { Picture } from 'astro:assets';
import { local, ruta, textos, type Idioma } from '../i18n';
import type { Proyecto } from '../lib/proyectos';
import Base from '../layouts/Base.astro';
import Galeria from './Galeria.astro';
import Lightbox from './Lightbox.astro';
import UIChrome from './UIChrome.astro';

interface Props {
  idioma: Idioma;
  proyecto: Proyecto;
  n: number;
}

const { idioma, proyecto, n } = Astro.props;
const t = textos(idioma);
const looks = proyecto.data.looks ?? [];
const i = looks.findIndex((l) => l.n === n);
const look = looks[i];
const anterior = looks[(i - 1 + looks.length) % looks.length];
const siguiente = looks[(i + 1) % looks.length];
const tituloProyecto = local(proyecto.data.titulo, idioma);
const nombre = local(look.nombre, idioma);
const caminoProyecto = `/proyectos/${proyecto.data.slug}/`;
const camino = `${caminoProyecto}look/${n}/`;
---

<Base idioma={idioma} camino={camino} titulo={`${nombre} · ${tituloProyecto}`} descripcion={local(look.descripcion, idioma)}>
  <UIChrome idioma={idioma} camino={camino} volver titulo={tituloProyecto} />
  <main id="contenido">
    <div class="contenedor">
      <a class="volver" href={ruta(caminoProyecto, idioma)}>← {t.proyecto.volverA} {tituloProyecto}</a>
    </div>
    <header class="contenedor look">
      <Picture
        src={look.portada}
        formats={['avif', 'webp']}
        widths={[640, 1280, 1920]}
        sizes="(min-width: 48rem) 45vw, 100vw"
        quality={78}
        alt={`${tituloProyecto} — ${nombre}`}
        loading="eager"
      />
      <div>
        <p class="rotulo">{tituloProyecto}</p>
        <h1 class="look__titulo">{nombre}</h1>
        <p class="look__desc">{local(look.descripcion, idioma)}</p>
      </div>
    </header>
    <Galeria fotos={look.galeria} titulo={`${tituloProyecto} — ${nombre}`} idioma={idioma} />
    <nav class="contenedor rondas" aria-label={`${t.proyecto.lookAnterior} / ${t.proyecto.lookSiguiente}`}>
      <a href={ruta(`${caminoProyecto}look/${anterior.n}/`, idioma)} rel="prev">
        <span class="rotulo">← {t.proyecto.lookAnterior}</span>
        <span class="rondas__titulo">{local(anterior.nombre, idioma)}</span>
      </a>
      <a class="rondas__sig" href={ruta(`${caminoProyecto}look/${siguiente.n}/`, idioma)} rel="next">
        <span class="rotulo">{t.proyecto.lookSiguiente} →</span>
        <span class="rondas__titulo">{local(siguiente.nombre, idioma)}</span>
      </a>
    </nav>
  </main>
  <Lightbox idioma={idioma} />
</Base>

<style>
  .volver {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 1rem;
    font-weight: 600;
  }
  .look {
    display: grid;
    gap: clamp(1rem, 4vw, 3rem);
    align-items: end;
    padding-block: 1rem 0;
  }
  @media (min-width: 48rem) {
    .look {
      grid-template-columns: 1fr 1fr;
    }
  }
  .look :global(img) {
    width: 100%;
  }
  .look__titulo {
    font-size: clamp(2.2rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .look__desc {
    margin-top: 1rem;
    font-size: 1.15rem;
    max-width: 34rem;
  }
  .rondas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-block: 2rem 3rem;
    border-top: 2px solid var(--tinta);
  }
  .rondas a {
    display: grid;
    gap: 0.2rem;
    text-decoration: none;
  }
  .rondas__sig {
    text-align: right;
  }
  .rondas__titulo {
    font-size: clamp(1.1rem, 3vw, 1.6rem);
    font-weight: 800;
  }
  .rondas a:hover .rondas__titulo {
    text-decoration: underline;
  }
</style>
