---
// Galería de un proyecto: fotos reales a calidad completa (AVIF/WebP con srcset) en una rejilla de
// 12 columnas. Cada foto enlaza a su versión grande: sin JS se abre sola; con JS, en el visor.
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
import { local, textos, type Idioma } from '../i18n';

interface Foto {
  src: ImageMetadata;
  tam: 'ancho' | 'mitad' | 'tercio' | 'cuarto';
  encajar: boolean;
  pie?: string | undefined;
  alt?: { es: string; en: string } | undefined;
}

interface Props {
  fotos: Foto[];
  /** Título del proyecto: base del texto alternativo provisional. */
  titulo: string;
  idioma: Idioma;
  etiqueta?: string | undefined;
}

const { fotos, titulo, idioma, etiqueta } = Astro.props;
const t = textos(idioma);
const ANCHOS = [640, 1280, 1920, 2560];
const SIZES = {
  ancho: '(min-width: 76rem) 76rem, 100vw',
  mitad: '(min-width: 48rem) 50vw, 100vw',
  tercio: '(min-width: 48rem) 33vw, 100vw',
  cuarto: '(min-width: 48rem) 25vw, 50vw',
};

const items = await Promise.all(
  fotos.map(async (f, i) => {
    const grande = await getImage({ src: f.src, width: Math.min(2560, f.src.width), format: 'webp', quality: 85 });
    const anchos = ANCHOS.filter((w) => w < f.src.width);
    // Texto alternativo provisional hasta que se escriban uno a uno (H8).
    const alt = f.alt
      ? local(f.alt, idioma)
      : `${titulo} — ${f.pie ?? `${t.proyecto.foto} ${i + 1} ${t.proyecto.de} ${fotos.length}`}`;
    return { ...f, grande: grande.src, anchos: [...anchos, f.src.width], alt };
  }),
);
---

{
  items.length > 0 && (
    <section class="contenedor galeria" data-galeria aria-label={etiqueta ?? titulo}>
      {etiqueta && <h2 class="rotulo galeria__etiqueta">{etiqueta}</h2>}
      {items.map((f, i) => (
        <figure class:list={['galeria__foto', `galeria__foto--${f.tam}`, { 'galeria__foto--encajar': f.encajar }]}>
          <a href={f.grande} data-lightbox data-pie={f.pie} aria-label={`${t.lightbox.abrir}: ${f.alt}`}>
            <Picture
              src={f.src}
              formats={['avif', 'webp']}
              widths={f.anchos}
              sizes={SIZES[f.tam]}
              quality={78}
              alt={f.alt}
              loading={i < 2 ? 'eager' : 'lazy'}
            />
          </a>
          {f.pie && <figcaption>{f.pie}</figcaption>}
        </figure>
      ))}
    </section>
  )
}

<style>
  .galeria {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(0.5rem, 1.5vw, 1rem);
    align-items: start;
    margin-block: clamp(2rem, 5vw, 3.5rem);
  }
  .galeria__etiqueta {
    grid-column: 1 / -1;
  }
  .galeria__foto {
    margin: 0;
    grid-column: span 12;
  }
  .galeria__foto a {
    display: block;
    cursor: zoom-in;
  }
  .galeria__foto :global(img) {
    width: 100%;
    background: var(--linea);
  }
  .galeria__foto--encajar a {
    background: #efe9dd;
    padding: clamp(0.5rem, 2vw, 1.5rem);
  }
  .galeria__foto--encajar :global(img) {
    background: transparent;
  }
  figcaption {
    margin-top: 0.4rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
  .galeria__foto--cuarto {
    grid-column: span 6;
  }
  @media (min-width: 48rem) {
    .galeria__foto--mitad {
      grid-column: span 6;
    }
    .galeria__foto--tercio {
      grid-column: span 4;
    }
    .galeria__foto--cuarto {
      grid-column: span 3;
    }
  }
</style>
