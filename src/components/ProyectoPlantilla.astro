---
// Plantilla provisional de página de proyecto (spec, sección 12): cabecera con el sprite del objeto,
// cuerpo content-first sin pixelar nada y «Ronda anterior / Siguiente ronda» al pie.
import { Picture } from 'astro:assets';
import { local, ruta, textos, type Idioma } from '../i18n';
import { rolDe, type Proyecto } from '../lib/proyectos';
import Base from '../layouts/Base.astro';
import Galeria from './Galeria.astro';
import Lightbox from './Lightbox.astro';
import SpriteObjeto from './SpriteObjeto.astro';
import UIChrome from './UIChrome.astro';
import VideoFachada from './VideoFachada.astro';

interface Props {
  idioma: Idioma;
  proyecto: Proyecto;
  anterior: Proyecto;
  siguiente: Proyecto;
}

const { idioma, proyecto, anterior, siguiente } = Astro.props;
const t = textos(idioma);
const d = proyecto.data;
const titulo = local(d.titulo, idioma);
const camino = `/proyectos/${d.slug}/`;
const rol = rolDe(proyecto, idioma);
const textosProyecto = [
  { id: 'sobre', titulo: t.proyecto.sobre, texto: local(d.sobre, idioma) },
  { id: 'proceso', titulo: t.proyecto.proceso, texto: local(d.proceso, idioma) },
  { id: 'resultado', titulo: t.proyecto.resultado, texto: local(d.resultado, idioma) },
].filter((b) => b.texto);
const [sobre, ...resto] = textosProyecto;
const descripcion = local(d.sobre, idioma) || `${titulo} · ${local(d.tipo, idioma)} · ${d.anio}`;
---

<Base idioma={idioma} camino={camino} titulo={titulo} descripcion={descripcion} sinIndexar={d.borrador}>
  <UIChrome idioma={idioma} camino={camino} volver titulo={titulo} />
  <main id="contenido">
    <header class="contenedor cabecera">
      <SpriteObjeto objeto={d.objeto} escala={5} class="cabecera__sprite" />
      <div>
        <p class="rotulo">{local(d.tipo, idioma)} · {d.anio}</p>
        <h1 class="cabecera__titulo">{titulo}</h1>
        {rol && <p class="cabecera__rol">{rol}</p>}
      </div>
    </header>

    {
      d.borrador ? (
        <section class="contenedor proximamente">
          <p class="proximamente__sello">{t.proyecto.proximamente}</p>
          <p>{t.proyecto.borrador}</p>
        </section>
      ) : (
        <>
          {d.video && <VideoFachada url={d.video} poster={d.portada} titulo={titulo} idioma={idioma} />}
          {sobre && (
            <section class="contenedor bloque" aria-labelledby={`t-${sobre.id}`}>
              <h2 class="rotulo" id={`t-${sobre.id}`}>{sobre.titulo}</h2>
              <p class="bloque__texto bloque__texto--grande">{sobre.texto}</p>
            </section>
          )}
          {d.looks && (
            <section class="contenedor looks" aria-labelledby="t-looks">
              <h2 class="rotulo" id="t-looks">{t.proyecto.looks}</h2>
              <ol class="looks__lista">
                {d.looks.map((l) => (
                  <li id={`look-${l.n}`}>
                    <a class="look" href={ruta(`${camino}look/${l.n}/`, idioma)}>
                      <Picture src={l.portada} formats={['avif', 'webp']} widths={[480, 960]} sizes="(min-width: 48rem) 33vw, 100vw" alt="" />
                      <span class="look__nombre">{local(l.nombre, idioma)}</span>
                      <span class="look__desc">{local(l.descripcion, idioma)}</span>
                      <span class="look__ver">{t.proyecto.verLook} →</span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          )}
          <Galeria fotos={d.galeria} titulo={titulo} idioma={idioma} etiqueta={d.rotuloGaleria && local(d.rotuloGaleria, idioma)} />
          {resto.map((b) => (
            <section class="contenedor bloque" aria-labelledby={`t-${b.id}`}>
              <h2 class="rotulo" id={`t-${b.id}`}>{b.titulo}</h2>
              <p class="bloque__texto">{b.texto}</p>
            </section>
          ))}
          {d.meta.length > 0 && (
            <section class="contenedor bloque" aria-labelledby="t-ficha">
              <h2 class="rotulo" id="t-ficha">{t.proyecto.ficha}</h2>
              <dl class="ficha">
                {d.meta.map((m) => (
                  <div>
                    <dt>{local(m.k, idioma)}</dt>
                    <dd>{local(m.v, idioma)}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}
        </>
      )
    }

    <nav class="contenedor rondas" aria-label={`${t.proyecto.anterior} / ${t.proyecto.siguiente}`}>
      <a class="ronda" href={ruta(`/proyectos/${anterior.data.slug}/`, idioma)} rel="prev">
        <span class="rotulo">← {t.proyecto.anterior}</span>
        <span class="ronda__titulo">{local(anterior.data.titulo, idioma)}</span>
      </a>
      <a class="ronda ronda--sig" href={ruta(`/proyectos/${siguiente.data.slug}/`, idioma)} rel="next">
        <span class="rotulo">{t.proyecto.siguiente} →</span>
        <span class="ronda__titulo">{local(siguiente.data.titulo, idioma)}</span>
      </a>
    </nav>
  </main>
  <Lightbox idioma={idioma} />
</Base>

<style>
  .cabecera {
    display: flex;
    align-items: flex-end;
    gap: clamp(1rem, 3vw, 2rem);
    padding-block: clamp(2rem, 6vw, 4.5rem) clamp(1rem, 3vw, 2rem);
    border-bottom: 1px solid var(--linea);
  }
  .cabecera :global(.cabecera__sprite) {
    flex: none;
  }
  .cabecera .rotulo {
    margin: 0 0 0.4rem;
  }
  .cabecera__titulo {
    font-size: clamp(2.6rem, 10vw, 6.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.92;
    overflow-wrap: anywhere;
  }
  .cabecera__rol {
    margin: 0.8rem 0 0;
    color: var(--tinta-suave);
  }
  .bloque {
    display: grid;
    gap: 0.6rem 2rem;
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }
  .bloque .rotulo {
    margin: 0.35rem 0 0;
  }
  .bloque__texto {
    max-width: var(--texto);
    margin: 0;
  }
  .bloque__texto--grande {
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    line-height: 1.45;
    max-width: 46rem;
  }
  @media (min-width: 48rem) {
    .bloque {
      grid-template-columns: 12rem 1fr;
    }
  }
  .ficha {
    margin: 0;
    display: grid;
    gap: 0;
    max-width: 46rem;
  }
  .ficha div {
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) 1fr;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--linea);
  }
  .ficha dt {
    font-weight: 700;
  }
  .ficha dd {
    margin: 0;
  }
  .looks {
    padding-block: clamp(1rem, 3vw, 2rem);
  }
  .looks__lista {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 48rem) {
    .looks__lista {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .look {
    display: grid;
    gap: 0.4rem;
    text-decoration: none;
  }
  .look :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  .look__nombre {
    font-weight: 800;
    font-size: 1.15rem;
  }
  .look__desc {
    color: var(--tinta-suave);
    font-size: 0.95rem;
  }
  .look__ver {
    font-weight: 700;
  }
  .look:hover .look__ver {
    text-decoration: underline;
  }
  .proximamente {
    padding-block: clamp(3rem, 10vw, 7rem);
    text-align: center;
  }
  .proximamente__sello {
    display: inline-block;
    padding: 0.4rem 1.2rem;
    border: 3px solid var(--tinta);
    font-size: clamp(1.4rem, 5vw, 2.4rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: rotate(-4deg);
  }
  .rondas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: clamp(2rem, 6vw, 4rem);
    padding-block: 2rem 3rem;
    border-top: 2px solid var(--tinta);
  }
  .ronda {
    display: grid;
    gap: 0.2rem;
    text-decoration: none;
    min-height: 44px;
  }
  .ronda--sig {
    text-align: right;
  }
  .ronda__titulo {
    font-size: clamp(1.2rem, 3.5vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .ronda:hover .ronda__titulo {
    text-decoration: underline;
  }
</style>
