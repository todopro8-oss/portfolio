---
// Páginas sencillas: la carta sola, la mesa de mus (hasta el H6) y el 404.
import { textos, type Idioma } from '../i18n';
import { proyectosDelBar } from '../lib/proyectos';
import Base from '../layouts/Base.astro';
import Carta from './Carta.astro';
import SpriteObjeto from './SpriteObjeto.astro';
import UIChrome from './UIChrome.astro';

interface Props {
  idioma: Idioma;
  tipo: 'carta' | 'mus' | '404';
}

const { idioma, tipo } = Astro.props;
const t = textos(idioma);
const proyectos = tipo === 'carta' ? await proyectosDelBar() : [];
const camino = tipo === 'carta' ? '/carta/' : tipo === 'mus' ? '/mus/' : '/';
const titulo = tipo === 'carta' ? t.carta.titulo : tipo === 'mus' ? t.mus.titulo : t.noEncontrado.titulo;
const descripcion = tipo === 'carta' ? t.carta.descripcion : tipo === 'mus' ? t.mus.descripcion : undefined;
---

<Base idioma={idioma} camino={camino} titulo={titulo} descripcion={descripcion} sinIndexar={tipo !== 'carta'}>
  <UIChrome idioma={idioma} camino={camino} volver />
  <main id="contenido">
    {
      tipo === 'carta' ? (
        <Carta idioma={idioma} proyectos={proyectos} h1={t.carta.titulo} />
      ) : (
        <section class="contenedor aviso">
          <SpriteObjeto objeto={tipo === 'mus' ? 'naipe' : 'cartel'} escala={6} />
          <h1>{titulo}</h1>
          <p>{tipo === 'mus' ? t.mus.texto : t.noEncontrado.texto}</p>
          <a class="boton" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${idioma === 'en' ? 'en/' : ''}carta/`}>
            {t.nav.carta}
          </a>
        </section>
      )
    }
  </main>
</Base>

<style>
  .aviso {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding-block: clamp(3rem, 12vw, 8rem);
    text-align: center;
  }
  .aviso h1 {
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 800;
  }
  .aviso p {
    max-width: 32rem;
    margin: 0;
  }
</style>
