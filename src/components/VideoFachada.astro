---
// Fachada ligera del vídeo: una foto propia y un botón. El iframe de youtube-nocookie.com solo se
// carga al pulsar (spec, sección 12): nada de terceros al abrir la página.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { textos, type Idioma } from '../i18n';
import { idYoutube } from '../lib/proyectos';

interface Props {
  url: string;
  poster?: ImageMetadata | undefined;
  titulo: string;
  idioma: Idioma;
}

const { url, poster, titulo, idioma } = Astro.props;
const t = textos(idioma).proyecto;
const id = idYoutube(url);
---

{
  id && (
    <section class="contenedor video" aria-label={`${t.video}: ${titulo}`}>
      <div class="video__caja" data-video={id} data-titulo={titulo}>
        <button class="video__boton" type="button" aria-describedby="aviso-video">
          {poster && (
            <Picture src={poster} formats={['avif', 'webp']} widths={[640, 1280, 1920]} sizes="(min-width: 76rem) 76rem, 100vw" alt="" loading="eager" />
          )}
          <span class="video__play">
            <span aria-hidden="true">▶</span> {t.reproducir}
          </span>
        </button>
      </div>
      <p id="aviso-video" class="video__aviso">
        {t.avisoVideo} <a href={url}>YouTube ↗</a>
      </p>
    </section>
  )
}

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-video]').forEach((caja) => {
      const boton = caja.querySelector('button');
      boton?.addEventListener(
        'click',
        () => {
          const iframe = document.createElement('iframe');
          iframe.src = `https://www.youtube-nocookie.com/embed/${caja.dataset.video}?autoplay=1&rel=0`;
          iframe.title = caja.dataset.titulo ?? 'Vídeo';
          iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
          iframe.allowFullscreen = true;
          caja.replaceChildren(iframe);
          iframe.focus();
        },
        { once: true },
      );
    });
  });
</script>

<style>
  .video {
    margin-block: clamp(1.5rem, 4vw, 3rem);
  }
  .video__caja {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--pizarra);
  }
  .video__caja :global(iframe),
  .video__boton {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video__boton {
    padding: 0;
    background: var(--pizarra);
    cursor: pointer;
  }
  .video__boton :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.82;
  }
  .video__play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    padding: 0.8rem 1.3rem;
    background: var(--fondo);
    color: var(--tinta);
    border: 2px solid var(--tinta);
    border-radius: 4px;
    box-shadow: 4px 4px 0 var(--tinta);
    font: inherit;
    font-weight: 700;
    white-space: nowrap;
  }
  .video__boton:hover .video__play {
    background: var(--oros);
  }
  .video__aviso {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--tinta-suave);
  }
</style>
