---
// Visor de fotos: <dialog> real con flechas, teclado (← → Esc), zoom al 100 % y paso con el dedo.
// Recorre las fotos de todas las galerías de la página en orden.
import { textos, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
}

const t = textos(Astro.props.idioma).lightbox;
---

<dialog class="visor" aria-label={t.abrir} data-visor>
  <div class="visor__marco" data-marco>
    <img class="visor__img" alt="" data-img />
  </div>
  <p class="visor__pie" aria-live="polite"><span data-cuenta></span> <span data-pie></span></p>
  <button class="visor__boton visor__cerrar" type="button" data-cerrar aria-label={t.cerrar}>✕</button>
  <button class="visor__boton visor__ant" type="button" data-ant aria-label={t.anterior}>←</button>
  <button class="visor__boton visor__sig" type="button" data-sig aria-label={t.siguiente}>→</button>
  <button class="visor__boton visor__zoom" type="button" data-zoom aria-label={t.ampliar} aria-pressed="false">＋</button>
</dialog>

<script>
  function iniciar(): void {
    const visor = document.querySelector<HTMLDialogElement>('[data-visor]');
    if (!visor || visor.dataset.listo) return;
    visor.dataset.listo = '1';
    const img = visor.querySelector<HTMLImageElement>('[data-img]')!;
    const marco = visor.querySelector<HTMLElement>('[data-marco]')!;
    const cuenta = visor.querySelector<HTMLElement>('[data-cuenta]')!;
    const pie = visor.querySelector<HTMLElement>('[data-pie]')!;
    const zoom = visor.querySelector<HTMLButtonElement>('[data-zoom]')!;
    const enlaces = [...document.querySelectorAll<HTMLAnchorElement>('[data-galeria] a[data-lightbox]')];
    let actual = 0;
    let origen: HTMLElement | null = null;

    const precargar = (i: number) => {
      const e = enlaces[(i + enlaces.length) % enlaces.length];
      if (e) new Image().src = e.href;
    };
    const ampliar = (si: boolean) => {
      visor.classList.toggle('visor--zoom', si);
      zoom.setAttribute('aria-pressed', String(si));
      zoom.textContent = si ? '－' : '＋';
    };
    const mostrar = (i: number) => {
      actual = (i + enlaces.length) % enlaces.length;
      const e = enlaces[actual];
      const miniatura = e.querySelector('img');
      ampliar(false);
      img.src = e.href;
      img.alt = miniatura?.alt ?? '';
      cuenta.textContent = `${actual + 1} / ${enlaces.length}`;
      pie.textContent = e.dataset.pie ?? '';
      precargar(actual + 1);
      precargar(actual - 1);
    };

    enlaces.forEach((e, i) =>
      e.addEventListener('click', (ev) => {
        if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.button !== 0) return;
        ev.preventDefault();
        origen = e;
        mostrar(i);
        visor.showModal();
      }),
    );
    visor.querySelector('[data-cerrar]')!.addEventListener('click', () => visor.close());
    visor.querySelector('[data-ant]')!.addEventListener('click', () => mostrar(actual - 1));
    visor.querySelector('[data-sig]')!.addEventListener('click', () => mostrar(actual + 1));
    zoom.addEventListener('click', () => ampliar(!visor.classList.contains('visor--zoom')));
    img.addEventListener('click', () => ampliar(!visor.classList.contains('visor--zoom')));
    visor.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowLeft') mostrar(actual - 1);
      else if (ev.key === 'ArrowRight') mostrar(actual + 1);
    });
    // Clic en el fondo oscuro: cerrar.
    visor.addEventListener('click', (ev) => {
      if (ev.target === visor || ev.target === marco) visor.close();
    });
    visor.addEventListener('close', () => {
      img.removeAttribute('src');
      origen?.focus();
    });
    // Deslizar con el dedo para pasar de foto (sin zoom).
    let x0: number | null = null;
    marco.addEventListener('touchstart', (ev) => (x0 = ev.touches[0].clientX), { passive: true });
    marco.addEventListener('touchend', (ev) => {
      if (x0 === null || visor.classList.contains('visor--zoom')) return;
      const dx = ev.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) mostrar(actual + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  }

  document.addEventListener('astro:page-load', iniciar);
</script>

<style>
  .visor {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(12 10 8 / 0.96);
    color: #f3ead6;
  }
  .visor::backdrop {
    background: rgb(12 10 8 / 0.9);
  }
  .visor__marco {
    position: absolute;
    inset: 3.5rem 0 3rem;
    display: grid;
    place-items: center;
    overflow: auto;
  }
  .visor__img {
    max-width: calc(100vw - 2rem);
    max-height: calc(100dvh - 7rem);
    object-fit: contain;
    cursor: zoom-in;
  }
  .visor--zoom .visor__marco {
    place-items: start;
  }
  .visor--zoom .visor__img {
    max-width: none;
    max-height: none;
    cursor: zoom-out;
  }
  .visor__pie {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.75rem;
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
  }
  .visor__boton {
    position: absolute;
    width: 44px;
    height: 44px;
    border: 2px solid #f3ead6;
    border-radius: 4px;
    background: rgb(12 10 8 / 0.6);
    color: #f3ead6;
    font: inherit;
    font-size: 1.1rem;
    cursor: pointer;
  }
  .visor__boton:hover {
    background: #f3ead6;
    color: #1a1410;
  }
  .visor__cerrar {
    top: 0.5rem;
    right: 0.5rem;
  }
  .visor__zoom {
    top: 0.5rem;
    right: 3.5rem;
  }
  .visor__ant,
  .visor__sig {
    top: 50%;
    transform: translateY(-50%);
  }
  .visor__ant {
    left: 0.5rem;
  }
  .visor__sig {
    right: 0.5rem;
  }
  .visor__boton:focus-visible {
    outline-color: #e2b227;
  }
</style>
